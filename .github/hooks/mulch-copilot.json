{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node .github/hooks/mulch-self-learning.mjs sessionStart",
        "powershell": "node .github/hooks/mulch-self-learning.mjs sessionStart",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node .github/hooks/mulch-self-learning.mjs userPromptSubmitted",
        "powershell": "node .github/hooks/mulch-self-learning.mjs userPromptSubmitted",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node .github/hooks/mulch-self-learning.mjs postToolUse",
        "powershell": "node .github/hooks/mulch-self-learning.mjs postToolUse",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "node .github/hooks/mulch-self-learning.mjs errorOccurred",
        "powershell": "node .github/hooks/mulch-self-learning.mjs errorOccurred",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node .github/hooks/mulch-self-learning.mjs sessionEnd",
        "powershell": "node .github/hooks/mulch-self-learning.mjs sessionEnd",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
